DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your-db-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_PROVIDER=smtp
MAIL_FROM=your-email@gmail.com
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_SSL_TRUST=smtp.gmail.com
MAIL_SMTP_CONNECTION_TIMEOUT=30000
MAIL_SMTP_TIMEOUT=30000
MAIL_SMTP_WRITE_TIMEOUT=30000

# If your host blocks outbound SMTP (ports 587 and 465 both time out),
# use SendGrid instead — it sends over HTTPS (port 443) which is always open.
# 1. Sign up at https://sendgrid.com (free tier: 100 emails/day)
# 2. Go to Settings > Sender Authentication > Single Sender Verification
# 3. Verify your Gmail address (no domain ownership required)
# 4. Go to Settings > API Keys > create a key with Mail Send permission
# 5. Set the env vars below and redeploy:
# MAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxx
# MAIL_FROM=your-verified-gmail@gmail.com

# For Gmail SSL mode instead of STARTTLS, use:
# MAIL_PORT=465
# MAIL_SMTP_STARTTLS_ENABLE=false
# MAIL_SMTP_SSL_ENABLE=true

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=yourSecretKeyForJWTWhichShouldBeAtLeast256BitsLongForHS256Algorithm

# Local API port
PORT=8080

# Comma-separated origins/patterns allowed by backend CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.ngrok-free.app,https://*.ngrok.io

# Dev toggles (use dot notation for Spring Boot properties)
dev.mode=true
seed.db=false
