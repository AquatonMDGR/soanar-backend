DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your-db-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=yourSecretKeyForJWTWhichShouldBeAtLeast256BitsLongForHS256Algorithm

# Comma-separated frontend origins that can call the backend API
# Example: cors.allowed-origins=https://soanar.pages.dev,http://localhost:3000
cors.allowed-origins=http://localhost:3000

# Dev toggles (use dot notation for Spring Boot properties)
dev.mode=true
seed.db=false
