DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your-db-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_PROVIDER=smtp
MAIL_FROM=your-email@gmail.com

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=yourSecretKeyForJWTWhichShouldBeAtLeast256BitsLongForHS256Algorithm

# Local API port
PORT=8080

# Comma-separated origins/patterns allowed by backend CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://*.ngrok-free.app,https://*.ngrok.io

# Dev toggles (use dot notation for Spring Boot properties)
dev.mode=true
seed.db=false
