DB_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
DB_USER=postgres
DB_PASSWORD=your-db-password

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=SOANAR

# smtp | resend | auto (auto tries SMTP then falls back to Resend)
MAIL_PROVIDER=smtp
MAIL_SEND_TIMEOUT_MS=10000
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

JWT_SECRET=yourSecretKeyForJWTWhichShouldBeAtLeast256BitsLongForHS256Algorithm

# Comma-separated web app origins allowed to call the API
cors.allowed-origins=http://localhost:3000,https://your-project.pages.dev

# Email domain policy for Google login
AUTH_ENFORCE_DOMAIN=true
AUTH_ALLOWED_DOMAIN=iacademy.edu.ph

# Railway sets PORT automatically; keep for local fallback if needed
PORT=8080

# Deployed frontend URL for share redirects and email links
FRONTEND_URL=https://your-frontend-url.workers.dev

# Dev toggles (use dot notation for Spring Boot properties)
dev.mode=true
seed.db=false
